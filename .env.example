# ---- Copy to .env and fill in. Never commit .env. ----
ENV=production

# PostgreSQL
POSTGRES_USER=sitewatch
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=sitewatch
DATABASE_URL=postgresql+psycopg://sitewatch:change-me-long-random@db:5432/sitewatch

REDIS_URL=redis://redis:6379/0

# Session cookies are Secure by default; only set false for local plain-http development.
COOKIE_SECURE=true
SESSION_TTL_HOURS=12

# Login protection
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_MAX_ATTEMPTS_PER_EMAIL=5
LOGIN_WINDOW_SECONDS=900
ACCOUNT_LOCKOUT_THRESHOLD=10
ACCOUNT_LOCKOUT_MINUTES=15

# Fernet key for encrypting stored provider credentials (phase 5). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Frontend -> API proxy target (inside docker network)
BACKEND_URL=http://api:8000

# ---- Email (alerts and reports) ----
# Any SMTP server or provider (Postmark, SES, SendGrid, Mailgun, Microsoft 365...).
# Leave SMTP_HOST empty to disable sending: notifications are then logged as "failed".
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_FROM=SiteWatch <alerts@your-agency.example>
# Used for links inside emails
APP_BASE_URL=https://monitor.your-agency.example

# ---- Uptime monitoring ----
RETRY_DELAY_S=30                  # wait between retries before an outage is confirmed
DEGRADED_ALERT_AFTER=3            # consecutive slow checks before a "slow response" alert
SERVER_ERROR_ALERT_THRESHOLD=3    # 5xx responses within the window -> alert
SERVER_ERROR_WINDOW_MINUTES=60
CHECK_NOW_COOLDOWN_S=30
UPTIME_CHECK_RETENTION_DAYS=400   # raw checks; hourly rollups are kept indefinitely
DISPATCH_INTERVAL_S=15

# Never set in production. Lets local tests monitor e.g. a site on 127.0.0.1.
# PRIVATE_TARGET_ALLOWLIST=["127.0.0.1/32"]

# ---- Domain / hosting / SSL expiry ----
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
# WHOIS (port 43) is only used for TLDs without RDAP. Registries' terms of use generally allow
# low-volume lookups about your own/clients' domains; disable if your policy requires it.
WHOIS_ENABLED=true
DOMAIN_ALERT_DAYS=[60,30,14,7]
HOSTING_ALERT_DAYS=[60,30,14,7]
SSL_ALERT_DAYS=[30,14,7,3,1]
